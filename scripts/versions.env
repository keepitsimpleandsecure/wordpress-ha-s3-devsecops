# Image Galera construite localement (images/mariadb-galera/Dockerfile) : doit correspondre a db_values.yaml
IMAGE_GALERA=localhost/mariadb-galera-corrige:12.0.2-r0-correctifs2
CHART_GALERA_VERSION=16.0.1
CHART_WP_VERSION=34.1.3
